    "app.share.duplicate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is already imported. What do you want to do?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は既に取り込み済みです。どうしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 이미 가져왔습니다. 어떻게 하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已经导入。要如何处理？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已經匯入。要如何處理？"
          }
        }
      }
    },
