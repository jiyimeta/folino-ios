{
  "sourceLanguage": "en",
  "strings": {
    "app.bootstrap.error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "folino couldn't start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "folino を起動できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "folino를 시작할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 folino"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動 folino"
          }
        }
      }
    },
    "app.detail.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a score"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楽譜を選択してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "악보를 선택하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一份乐谱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一份樂譜"
          }
        }
      }
    },
    "app.import.loading.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開啟…"
          }
        }
      }
    },
    "app.review.preprompt.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you mind taking a moment to leave a review on the App Store?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store でレビューを書いていただけますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 리뷰를 남겨 주시겠어요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在 App Store 上为我们写一条评论吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在 App Store 上為我們留下評論嗎？"
          }
        }
      }
    },
    "app.review.preprompt.notNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後"
          }
        }
      }
    },
    "app.review.preprompt.rate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate folino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "folino を評価する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "folino 평가하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 folino 评分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 folino 評分"
          }
        }
      }
    },
    "app.review.preprompt.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoying folino?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "folino はいかがですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "folino는 어떠신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您觉得 folino 怎么样？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您覺得 folino 如何？"
          }
        }
      }
    },
