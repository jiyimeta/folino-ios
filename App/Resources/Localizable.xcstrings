{
  "sourceLanguage": "en",
  "strings": {
    "app.bootstrap.error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "folino couldn't start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "folino を起動できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "folino를 시작할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 folino"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動 folino"
          }
        }
      }
    },
    "app.detail.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a score"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楽譜を選択してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "악보를 선택하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一份乐谱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一份樂譜"
          }
        }
      }
    },
    "app.import.loading.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開啟…"
          }
        }
      }
    },
    "app.review.preprompt.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you mind taking a moment to leave a review on the App Store?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store でレビューを書いていただけますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 리뷰를 남겨 주시겠어요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在 App Store 上为我们写一条评论吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在 App Store 上為我們留下評論嗎？"
          }
        }
      }
    },
    "app.review.preprompt.notNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後"
          }
        }
      }
    },
    "app.review.preprompt.rate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate folino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "folino を評価する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "folino 평가하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 folino 评分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 folino 評分"
          }
        }
      }
    },
    "app.review.preprompt.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoying folino?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "folino はいかがですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "folino는 어떠신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您觉得 folino 怎么样？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您覺得 folino 如何？"
          }
        }
      }
    },
    "app.share.duplicate.keepBoth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Both"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 유지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "都保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "都保留"
          }
        }
      }
    },
    "app.share.duplicate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is already imported. What do you want to do?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は既に取り込み済みです。どうしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 이미 가져왔습니다. 어떻게 하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已经导入。要如何处理？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已經匯入。要如何處理？"
          }
        }
      }
    },
    "app.share.duplicate.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in Your Library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに既に存在します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리에 이미 존재합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库中已存在"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫中已存在"
          }
        }
      }
    },
    "app.toolbar.settings.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
