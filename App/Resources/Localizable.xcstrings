        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리 저장에 실패했습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存资料库失败：%@"
