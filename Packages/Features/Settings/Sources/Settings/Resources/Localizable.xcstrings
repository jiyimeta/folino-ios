    "settings.reader.continuation.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you set a per-score repeat (single or A–B), it takes priority and playback won't advance to the next score."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽譜ごとに「1曲」または「A–B」リピートを設定している場合は、そちらが優先され、次の楽譜へは進みません。"
          }
        }
      }
    },
    "" : {
      "shouldTranslate" : false
    },
    "•" : {
      "shouldTranslate" : false
    },
    "settings.playback.a4Reference.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reference pitch applied to all scores. Each score can override it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての楽譜の再生に適用される基準です。楽譜ごとに上書きできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 악보에 적용되는 기준입니다. 악보별로 재정의할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用于所有乐谱的基准音。可按乐谱单独覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用於所有樂譜的基準音。可依樂譜個別覆寫。"
          }
        }
      }
    },
    "settings.playback.a4Reference.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
