    "settings.soundfont.delete.alert.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the 206 MB download. Playback returns to the bundled lightweight soundfont."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの 206 MB を削除し、デフォルトの軽量音源での再生に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 206 MB를 삭제하고 기본 경량 음원으로 재생이 돌아갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除已下载的 206 MB，播放将切换回内置轻量音源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除已下載的 206 MB，播放將切換回內建輕量音源。"
          }
        }
      }
    },
