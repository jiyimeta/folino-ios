    "settings.reader.pictureInPicture" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picture in Picture"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピクチャインピクチャ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "픽처 인 픽처"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画中画"
          }
