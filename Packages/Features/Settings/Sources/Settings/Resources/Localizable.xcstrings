    "settings.reader.pictureInPicture" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picture in Picture"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピクチャインピクチャ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "픽처 인 픽처"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画中画"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫中畫"
          }
        }
      }
    },
    "settings.reader.pictureInPicture.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the score visible in a mini-player while another app is in use. Requires \"Start Picture in Picture Automatically\" to be enabled in device Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のアプリを使っている間、ミニプレーヤーで楽譜の表示を継続します。デバイスの設定で「ピクチャインピクチャを自動的に開始」もオンにする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱을 사용하는 동안 미니 플레이어로 악보를 계속 표시합니다. 기기 설정에서 '픽처 인 픽처 자동 시작'도 켜야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在使用其他 App 时，迷你播放器会继续显示乐谱。还需要在设备设置中开启「自动启动画中画」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在使用其他 App 時，迷你播放器會繼續顯示樂譜。還需要在裝置設定中啟用「自動啟動畫中畫」。"
          }
        }
      }
    },
