        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設校準"
          }
        }
      }
    },
    "settings.privacy.crashReporting.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps fix bugs by sharing anonymous crash diagnostics. Never linked to you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名のクラッシュ診断を共有して不具合の修正に役立てます。個人とは結び付けられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익명 오류 진단을 공유해 버그 수정에 도움을 줍니다. 사용자와 연결되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享匿名崩溃诊断信息以帮助修复缺陷。绝不与您关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享匿名當機診斷以協助修正錯誤。絕不與您關聯。"
          }
        }
      }
    },
