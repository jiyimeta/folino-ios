    "settings.reader.keepScreenAwake" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent auto-lock"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ロックを抑止"
