      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Delete all cached soundfonts?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "キャッシュをすべて削除しますか？" } }
      }
    },
    "Cached files will be re-downloaded the next time they're needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cached files will be re-downloaded the next time they're needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した音源は次に必要になったときに再ダウンロードされます。"
