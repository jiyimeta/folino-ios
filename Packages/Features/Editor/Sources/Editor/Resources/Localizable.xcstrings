    "editor.notice.savedAsMscz": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits are saved as a MuseScore (.mscz) copy next to the original file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集内容は元のファイルの隣に MuseScore (.mscz) 形式のコピーとして保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 내용은 원본 파일 옆에 MuseScore(.mscz) 사본으로 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑内容将保存为原文件旁的 MuseScore (.mscz) 副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯內容將儲存為原始檔案旁的 MuseScore (.mscz) 副本。"
          }
        }
      }
    },
