    "editor.instruments.shortName.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engraved at the left of every system after the first. Leave it empty for no label."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 段目以降の譜表の左に表示されます。空にするとラベルなしになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘째 단부터 보표 왼쪽에 표시됩니다. 비워 두면 라벨이 표시되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在第二行起每行谱表的左侧。留空则不显示标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在第二行起每行譜表的左側。留空則不顯示標籤。"
          }
        }
      }
    },
