          }
        }
      }
    },
    "editor.discard.confirm.message": {
      "comment": "Body of the confirmation ✕ raises when the session has unsaved-in-spirit changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to\ndiscard your changes?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄しても\nよろしいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을\n버리시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要放弃\n所做的更改吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要放棄\n所做的更改嗎？"
          }
        }
      }
    },
