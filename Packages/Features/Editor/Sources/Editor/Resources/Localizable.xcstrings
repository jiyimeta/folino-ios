    "editor.discard.action": {
      "comment": "Accessibility label for the ✕ that throws away the current editing session's changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 버리기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄更改"
          }
        }
      }
    },
    "editor.discard.confirm.action": {
      "comment": "Destructive button that throws away the current editing session's changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を破棄"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 버리기"
          }
        },
