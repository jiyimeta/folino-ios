    },
    "editor.instruments.delete.message": {
      "comment": "Body of the part-removal confirmation: the part's music goes with it, and it is undoable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notes written for this instrument are deleted too. You can bring them back with undo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この楽器の音符も削除されます。取り消すには元に戻すを使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 악기에 입력한 음표도 함께 삭제됩니다. 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为该乐器写的音符也会一并删除。可以通过撤销恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為該樂器寫的音符也會一併刪除。可以透過還原復原。"
          }
        }
      }
    },
    "editor.instruments.delete.title %@": {
      "comment": "Confirmation title before removing a part. %@ is the instrument's name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除%@吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除%@嗎？"
          }
        }
      }
    },
