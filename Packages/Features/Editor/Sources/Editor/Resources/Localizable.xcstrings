    "editor.revert.confirm.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverting to the original deletes every edit you have made to this score."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルに戻すと、この楽譜に加えた編集内容が全て削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본으로 되돌리면 이 악보에 적용한 편집 내용이 모두 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复到原始版本会删除你对这份乐谱所做的全部编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原至原始版本會刪除你對這份樂譜所做的全部編輯。"
          }
        }
      }
    },
    "editor.revert.confirm.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
