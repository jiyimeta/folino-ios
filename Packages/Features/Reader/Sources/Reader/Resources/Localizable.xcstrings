    "reader.displaySource.showOriginal.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback works on the PDF too. Turn this off to show the sheet music folino parsed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF上でも再生できます。オフにすると解析済みの楽譜を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF에서도 재생할 수 있습니다. 끄면 분석된 악보를 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 PDF 上也可以播放。关闭后将显示解析后的乐谱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 PDF 上也可以播放。關閉後將顯示解析後的樂譜。"
          }
        }
