    "reader.hint.noteEditing.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewrite the notes in the score itself. Select a note to change its pitch, duration or accidental — and enter new notes too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽譜の音符を直接書き換えられます。音符を選び、音の高さ・長さ・臨時記号などを変更できます。新しく音符を入力することも可能です。"
          }
        }
      }
    },
    "reader.hint.noteEditing.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit the notes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符を編集"
          }
        }
      }
    },
    "reader.hint.notePad.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter notes and rests. With a place in the score selected, pick the duration and kind to enter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符・休符を入力できます。楽譜上の場所を選択した状態で、長さと種類を指定して入力してください。"
          }
        }
      }
    },
    "reader.hint.notePad.title" : {
