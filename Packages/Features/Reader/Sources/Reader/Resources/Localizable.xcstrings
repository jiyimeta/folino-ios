    "reader.pdf.reread.confirm.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your note edits and per-staff settings (clef, visibility, instrument, volume, transposition) will be lost. Annotations are kept, but they may shift."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符の編集内容と、譜表ごとの設定（音部記号・表示/非表示・音色・音量・移調）は失われます。書き込みは残りますが、位置がずれることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음표 편집 내용과 보표별 설정(음자리표, 표시/숨김, 음색, 음량, 조옮김)이 사라집니다. 필기는 남지만 위치가 어긋날 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符的编辑内容和各谱表的设置（谱号、显示/隐藏、音色、音量、移调）将丢失。手写批注会保留，但位置可能会偏移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音符的編輯內容和各譜表的設定（譜號、顯示/隱藏、音色、音量、移調）將遺失。手寫註記會保留，但位置可能會偏移。"
          }
        }
      }
    },
    "reader.pdf.reread.confirm.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parse this PDF again?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFから解析し直しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF에서 다시 분석할까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要重新解析此 PDF 吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要重新解析此 PDF 嗎？"
          }
        }
      }
    },
    "reader.pdf.reread.failed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "folino couldn't parse sheet music out of this PDF. Your score is unchanged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPDFから楽譜を解析できませんでした。楽譜はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PDF에서 악보를 분석할 수 없습니다. 악보는 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从此 PDF 解析出乐谱。乐谱保持不变。"
          }
        },
        "zh-Hant" : {
