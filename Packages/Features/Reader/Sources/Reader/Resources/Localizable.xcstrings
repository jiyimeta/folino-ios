    "reader.pdf.source.unavailable.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "folino couldn't parse sheet music out of this PDF, so it's shown as it is. You can try again any time from the PDF badge's menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
