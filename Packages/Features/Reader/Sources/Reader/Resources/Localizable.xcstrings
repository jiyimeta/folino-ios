    "reader.hint.mixer.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From playback settings, balance each part's volume, or mute and solo to hear just the ones you want."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生設定から、パートごとの音量を調整したり、ミュート/ソロで聴きたいパートだけを鳴らせます。"
          }
        }
      }
    },
