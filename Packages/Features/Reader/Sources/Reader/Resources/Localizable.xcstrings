    "reader.hint.repeatPlayback.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From playback settings, repeat the whole piece or loop just the passage you want to practice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生設定から、曲全体のリピートや、練習したい範囲だけを繰り返す A–B ループを設定できます。"
          }
        }
      }
    },
