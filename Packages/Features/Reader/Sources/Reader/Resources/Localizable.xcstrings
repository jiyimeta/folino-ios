    "reader.pdf.settingsNote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display adjustments like staff size and hiding staves aren't available for PDF scores. Playback settings are."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 楽譜では譜表サイズや譜表の非表示などの表示調整は利用できませんが、再生設定は利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 악보에서는 보표 크기나 보표 숨기기 같은 표시 조정을 사용할 수 없지만 재생 설정은 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 乐谱不支持谱表大小、隐藏谱表等显示调整，但可以使用播放设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 樂譜不支援譜表大小、隱藏譜表等顯示調整，但可以使用播放設定。"
          }
        }
      }
    },
    "reader.pdf.source.notice.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parsing is highly accurate, but it is occasionally wrong. Fix a note on the spot with the note-editing button above. You can also show the original PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF解析は高精度ですが、まれに誤りがあります。上の音符編集ボタンから、その場で修正できます。元のPDFを表示することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 분석은 정확도가 높지만 드물게 오류가 있습니다. 위의 음표 편집 버튼에서 바로 수정할 수 있습니다. 원본 PDF를 표시할 수도 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 解析准确度很高，但偶尔会有错误。可以用上方的音符编辑按钮当场修改。也可以显示原始 PDF。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 解析準確度很高，但偶爾會有錯誤。可以用上方的音符編輯按鈕當場修改。也可以顯示原始 PDF。"
          }
        }
      }
    },
