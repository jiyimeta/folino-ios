    "library.browser.empty.hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose File ▸ Import… (⇧⌘I), or drag score files onto this window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの「ファイル」▸「読み込む…」（⇧⌘I）を選ぶか、楽譜ファイルをこのウインドウにドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대에서 파일 ▸ 가져오기…(⇧⌘I)를 선택하거나, 악보 파일을 이 창으로 끌어다 놓으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏选择“文件”▸“导入…”（⇧⌘I），或将乐谱文件拖到此窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列選擇「檔案」▸「匯入…」（⇧⌘I），或將樂譜檔案拖到此視窗。"
          }
        }
      }
    },
