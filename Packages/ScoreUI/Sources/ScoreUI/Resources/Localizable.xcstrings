    "scoreUI.revert.confirm.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every note change will be discarded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加えた音符の変更はすべて破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 변경한 음표는 모두 취소됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您所做的所有音符更改都将被放弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您所做的所有音符變更都將被捨棄。"
          }
        }
      }
    },
