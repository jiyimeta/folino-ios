    "scoreUI.revert.confirm.inkMayShift" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handwriting anchored to the notation may move."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽譜に紐づいた手書きは位置がずれることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "악보에 연결된 손글씨는 위치가 달라질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与乐谱关联的手写内容可能会移位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與樂譜關聯的手寫內容可能會移位。"
          }
        }
      }
    },
    "scoreUI.revert.confirm.mayNotBeImport" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This score was in your library before folino started keeping originals, so the saved version may already include earlier edits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この楽譜は folino がオリジナルを保存し始める前からライブラリにあるため、保存されている状態には以前の編集が含まれている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 악보는 folino가 원본을 보관하기 시작하기 전부터 라이브러리에 있었으므로, 저장된 원본에는 이전 편집 내용이 이미 포함되어 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此乐谱在 folino 开始保存原始文件之前就已在您的资料库中，因此保存的原始版本可能已包含之前的编辑内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此樂譜在 folino 開始保存原始檔案之前就已在您的資料庫中，因此保存的原始版本可能已包含先前的編輯內容。"
          }
        }
      }
    },
