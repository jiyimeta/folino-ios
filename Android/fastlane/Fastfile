default_platform(:android)

require "tmpdir"
require "fileutils"

# Keep our hand-written fastlane/README.md — without this, fastlane regenerates it (clobbering the docs)
# on every run.
skip_docs

# Release + store-listing automation via fastlane supply.
#
# `release` is the one lane that ships a binary (AAB + release notes). Every other lane touches the
# store listing only and never uploads an artifact.
#
# Screenshots are generated by the instrumented capture harness, NOT fastlane:
#   ANDROID_SERIAL=emulator-5554 ./gradlew :app:collectScreenshots
# That copies PNGs into fastlane/metadata/android/<locale>/images/<phoneScreenshots|tenInchScreenshots>/.
# The lanes here only upload what's already on disk.
#
# Required environment (read by Appfile):
#   PLAY_PACKAGE_NAME    published applicationId (default com.harmolo.folino)
#   PLAY_JSON_KEY_PATH   path to the Play service-account JSON key
# Set PLAY_VALIDATE_ONLY=1 on any lane for a dry run (no changes committed to Play).

platform :android do
  desc "Build the signed release AAB and ship it to Play — binary + release notes only."
  desc "The store listing (text, icon, feature graphic, screenshots) is left untouched; use"
  desc "upload_listing for that. Defaults to the production track."
  desc "  PLAY_TRACK=internal      stage on another track instead of production"
  desc "  PLAY_VALIDATE_ONLY=1     dry run — nothing is committed to Play"
  desc "  PLAY_SKIP_BUILD=1        upload the AAB already on disk instead of rebuilding"
  desc "  PLAY_ROLLOUT=0.1         staged rollout fraction (omit for a full release)"
  lane :release do
    android_dir = File.expand_path("..", __dir__)

    # versionCode is derived from the commit count (see app/build.gradle.kts), so resolve it the same
    # way rather than parsing it back out of the bundle's protobuf manifest. Used only to verify the
    # release notes exist — supply reads the real code off the uploaded AAB.
    version_code = sh("git", "-C", android_dir, "rev-list", "--count", "HEAD", log: false).strip.to_i
    UI.user_error!("could not resolve versionCode from the commit count") if version_code.zero?

    metadata = File.expand_path("metadata/android", __dir__)
    missing = Dir.glob(File.join(metadata, "*"))
                 .select { |dir| File.directory?(dir) }
                 .reject { |dir| File.exist?(File.join(dir, "changelogs", "#{version_code}.txt")) }
                 .map { |dir| File.basename(dir) }
    unless missing.empty?
      UI.user_error!("missing changelogs/#{version_code}.txt for: #{missing.join(', ')}")
    end

    gradle(project_dir: android_dir, task: "bundle", build_type: "Release") unless ENV["PLAY_SKIP_BUILD"] == "1"

    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH] ||
          File.join(android_dir, "app/build/outputs/bundle/release/app-release.aab")
    UI.user_error!("no AAB at #{aab} — drop PLAY_SKIP_BUILD to build one") unless File.exist?(aab)
    UI.message("uploading #{aab} (versionCode #{version_code})")

    params = {
      aab: aab,
      track: ENV.fetch("PLAY_TRACK", "production"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1",
    }
    params[:rollout] = ENV["PLAY_ROLLOUT"] if ENV["PLAY_ROLLOUT"]
    upload_to_play_store(**params)
  end

  desc "Download the current Play Store listing (text + images) into fastlane/metadata"
  desc "Run once to reuse what you already entered in the Play Console, then edit locally."
  lane :download_metadata do
    sh(
      "bundle", "exec", "fastlane", "supply", "init",
      "--package_name", ENV.fetch("PLAY_PACKAGE_NAME", "com.harmolo.folino"),
      "--json_key", ENV.fetch("PLAY_JSON_KEY_PATH", ""),
      "--metadata_path", File.expand_path("metadata/android", __dir__)
    )
  end

  desc "Upload only the Play Store screenshots (no binary, no metadata, no changelog)"
  lane :upload_screenshots do
    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "internal"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1"
    )
  end

  desc "Upload the full store listing: titles, descriptions, icon, feature graphic, screenshots."
  desc "No binary and no release-track changelog are touched — listing edits only."
  lane :upload_listing do
    upload_to_play_store(
      # Store listing is global, but supply still resolves a track+release for its changelog path.
      # Point it at the track that actually has a release (the first AAB went to internal).
      track: ENV.fetch("PLAY_TRACK", "internal"),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1"
    )
  end

  desc "Upload ONLY the feature graphic — no icon, text, screenshots, or binary."
  desc "Copies just featureGraphic.png per locale into a temp metadata tree and uploads from there, so"
  desc "supply touches nothing else: the store icon stays untouched (icon updates can be rejected by the"
  desc "Play API) and no text/screenshots are re-pushed. Set PLAY_VALIDATE_ONLY=1 for a dry run."
  lane :upload_feature_graphic do
    src = File.expand_path("metadata/android", __dir__)
    tmp = File.join(Dir.mktmpdir("folino-fg-upload"), "android")
    Dir.glob(File.join(src, "*", "images", "featureGraphic.png")).each do |fg|
      locale = File.basename(File.dirname(File.dirname(fg)))
      dest = File.join(tmp, locale, "images")
      FileUtils.mkdir_p(dest)
      FileUtils.cp(fg, File.join(dest, "featureGraphic.png"))
    end
    found = Dir.glob(File.join(tmp, "*", "images", "featureGraphic.png"))
    UI.user_error!("no featureGraphic.png found under #{src}") if found.empty?
    UI.message("feature graphic only — uploading #{found.length} locale(s) from #{tmp}")
    # The feature graphic is a global listing asset, but supply still resolves a track release. Default to
    # production (the live track). If a track has several releases, set PLAY_VERSION_CODE to disambiguate.
    params = {
      track: ENV.fetch("PLAY_TRACK", "production"),
      metadata_path: tmp,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "1",
    }
    params[:version_code] = ENV["PLAY_VERSION_CODE"].to_i if ENV["PLAY_VERSION_CODE"]
    upload_to_play_store(**params)
  end
end
