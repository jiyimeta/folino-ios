    <!-- Reader coach marks. Copy is the same feature's copy on iOS
         (Reader/Resources/Localizable.xcstrings, reader.hint.*) — the one deliberate change is the
         annotation message, which names a stylus rather than Apple Pencil. Which of these is offered,
         when, and when it retires is decided by the shared ReaderHintEngine, not here. -->
    <string name="reader_hint_transport_collapse_title">右にスワイプで小さく表示</string>
    <string name="reader_hint_transport_collapse_message">再生コントロールの下部を右にスワイプすると、小さい表示に切り替えられます。</string>
    <string name="reader_hint_transport_expand_title">左にスワイプで大きく表示</string>
    <string name="reader_hint_transport_expand_message">再生コントロールを左にスワイプすると、大きい表示に切り替えられます。</string>
    <string name="reader_hint_note_editing_title">音符を編集</string>
    <string name="reader_hint_note_editing_message">楽譜の音符を直接書き換えられます。音符を選び、音の高さ・長さ・臨時記号などを変更できます。新しく音符を入力することも可能です。</string>
    <string name="reader_hint_annotation_title">楽譜に書き込む</string>
    <string name="reader_hint_annotation_message_tablet">スタイラスや指で、楽譜に直接メモを書き込めます。</string>
    <string name="reader_hint_annotation_message_phone">指で楽譜に直接メモを書き込めます。</string>
    <string name="reader_hint_staff_visibility_title">パートを非表示</string>
    <string name="reader_hint_staff_visibility_message">表示設定から、演奏しないパートを隠し、自分のパートだけを大きく表示できます。</string>
    <string name="reader_hint_metronome_title">メトロノーム</string>
    <string name="reader_hint_metronome_message">再生設定から、メトロノームを鳴らすかどうかを切り替えられます。</string>
    <string name="reader_hint_repeat_playback_title">リピート・A–B ループ</string>
    <string name="reader_hint_repeat_playback_message">再生設定から、曲全体のリピートや、練習したい範囲だけを繰り返す A–B ループを設定できます。</string>
    <string name="reader_hint_mixer_title">パートごとの音量</string>
    <string name="reader_hint_mixer_message">再生設定から、パートごとの音量を調整したり、ミュート/ソロで聴きたいパートだけを鳴らせます。</string>
