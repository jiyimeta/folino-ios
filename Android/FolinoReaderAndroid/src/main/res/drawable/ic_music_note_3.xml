<?xml version="1.0" encoding="utf-8"?>
<!--
  Three quarter notes, rising. Android's answer to iOS's `music.quarternote.3`, which the Reader's
  "Edit notes" button uses: notes rather than a pencil-on-a-page, because a compose glyph reads as
  "make a new score" on a screen where a score is already open.

  Hand-drawn because Material's icon set has no multi-note glyph — `MusicNote` and `Audiotrack` are
  both a single note, and everything else with "music" in its name wraps one in a card or a list.
  Drawn to Material's 24dp grid: heads are 5.4 x 4.4 ellipses, stems 1.3 wide meeting each head's
  right edge, and the whole group is centred on (12, 12) so it optically matches the stock icons
  beside it.

  No android:tint here on purpose: Compose's `Icon` applies `LocalContentColor`, and a baked tint
  would fight the disabled / selected states the top bar puts it through.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M3.3,16.9 a2.7,2.2 0 1,0 5.4,0 a2.7,2.2 0 1,0 -5.4,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M7.4,16.9 V7.9 H8.7 V16.9 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9.3,15.4 a2.7,2.2 0 1,0 5.4,0 a2.7,2.2 0 1,0 -5.4,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M13.4,15.4 V6.4 H14.7 V15.4 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15.3,13.9 a2.7,2.2 0 1,0 5.4,0 a2.7,2.2 0 1,0 -5.4,0 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.4,13.9 V4.9 H20.7 V13.9 Z" />
</vector>
