    <!-- Reader coach marks. Copy is the same feature's copy on iOS
         (Reader/Resources/Localizable.xcstrings, reader.hint.*) — the one deliberate change is the
         annotation message, which names a stylus rather than Apple Pencil. Which of these is offered,
         when, and when it retires is decided by the shared ReaderHintEngine, not here. -->
    <string name="reader_hint_transport_collapse_title">向右滑动可缩小显示</string>
    <string name="reader_hint_transport_collapse_message">将播放控件下方向右滑动，即可切换为小尺寸显示。</string>
    <string name="reader_hint_transport_expand_title">向左滑动可放大显示</string>
    <string name="reader_hint_transport_expand_message">将播放控件向左滑动，即可切换为大尺寸显示。</string>
    <string name="reader_hint_note_editing_title">编辑音符</string>
    <string name="reader_hint_note_editing_message">可直接改写乐谱中的音符。选中音符即可更改音高、时值、临时记号等，也可以输入新的音符。</string>
    <string name="reader_hint_annotation_title">在乐谱上书写</string>
    <string name="reader_hint_annotation_message_tablet">可用触控笔或手指直接在乐谱上做笔记。</string>
    <string name="reader_hint_annotation_message_phone">可用手指直接在乐谱上做笔记。</string>
    <string name="reader_hint_staff_visibility_title">隐藏声部</string>
    <string name="reader_hint_staff_visibility_message">在显示设置中隐藏不演奏的声部，让自己的声部显示得更大。</string>
    <string name="reader_hint_metronome_title">节拍器</string>
    <string name="reader_hint_metronome_message">在播放设置中可切换是否播放节拍器。</string>
    <string name="reader_hint_repeat_playback_title">重复与 A–B 循环</string>
    <string name="reader_hint_repeat_playback_message">在播放设置中可设置整首重复，或只循环想要练习的片段的 A–B 循环。</string>
    <string name="reader_hint_mixer_title">各声部音量</string>
    <string name="reader_hint_mixer_message">在播放设置中可调整各声部的音量，或用静音/独奏只听想听的声部。</string>
