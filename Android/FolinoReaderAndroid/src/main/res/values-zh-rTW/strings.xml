    <!-- Reader coach marks. Copy is the same feature's copy on iOS
         (Reader/Resources/Localizable.xcstrings, reader.hint.*) — the one deliberate change is the
         annotation message, which names a stylus rather than Apple Pencil. Which of these is offered,
         when, and when it retires is decided by the shared ReaderHintEngine, not here. -->
    <string name="reader_hint_transport_collapse_title">向右滑動可縮小顯示</string>
    <string name="reader_hint_transport_collapse_message">將播放控制項下方向右滑動，即可切換為小尺寸顯示。</string>
    <string name="reader_hint_transport_expand_title">向左滑動可放大顯示</string>
    <string name="reader_hint_transport_expand_message">將播放控制項向左滑動，即可切換為大尺寸顯示。</string>
    <string name="reader_hint_note_editing_title">編輯音符</string>
    <string name="reader_hint_note_editing_message">可直接改寫樂譜中的音符。選取音符即可更改音高、時值、臨時記號等，也可以輸入新的音符。</string>
    <string name="reader_hint_annotation_title">在樂譜上書寫</string>
    <string name="reader_hint_annotation_message_tablet">可用觸控筆或手指直接在樂譜上做筆記。</string>
    <string name="reader_hint_annotation_message_phone">可用手指直接在樂譜上做筆記。</string>
    <string name="reader_hint_staff_visibility_title">隱藏聲部</string>
    <string name="reader_hint_staff_visibility_message">在顯示設定中隱藏不演奏的聲部，讓自己的聲部顯示得更大。</string>
    <string name="reader_hint_metronome_title">節拍器</string>
    <string name="reader_hint_metronome_message">在播放設定中可切換是否播放節拍器。</string>
    <string name="reader_hint_repeat_playback_title">重複與 A–B 循環</string>
    <string name="reader_hint_repeat_playback_message">在播放設定中可設定整首重複，或只循環想要練習的片段的 A–B 循環。</string>
    <string name="reader_hint_mixer_title">各聲部音量</string>
    <string name="reader_hint_mixer_message">在播放設定中可調整各聲部的音量，或用靜音/獨奏只聽想聽的聲部。</string>
